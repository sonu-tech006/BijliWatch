# GEMINI_API_KEY: Optional runtime AI analysis key if configured
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT="3000"

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster.mongodb.net/bijliwatch?retryWrites=true&w=majority)
# If not provided, BijliWatch runs in robust built-in persistent resilient mode with full MongoDB schema validation!
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bijliwatch?retryWrites=true&w=majority"

# JWT_SECRET: Strong secret for signing authentication tokens
JWT_SECRET="bijliwatch_super_secure_jwt_secret_change_in_production"

# CLOUDINARY CONFIGURATION (For genuine bill and meter photo uploads)
# Sign up at https://cloudinary.com/ for free cloud storage for utility bills & resolution evidence
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
